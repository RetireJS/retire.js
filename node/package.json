{
  "author": "Erlend Oftedal <erlend@oftedal.no>",
  "name": "retire",
  "description": "Retire is a tool for detecting use of vulnerable libraries",
  "version": "6.0.0",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/RetireJS/retire.js.git"
  },
  "bin": {
    "retire": "./lib/cli.js"
  },
  "main": "./lib/retire.js",
  "dependencies": {
    "astronomical": "^3.2.0",
    "commander": "^14.0.3",
    "walkdir": "0.4.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^18.13.0",
    "@types/uuid": "^10.0.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "jsonschema": "^1.4.1",
    "prettier": "^3.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1"
  },
  "scripts": {
    "test": "TS_NODE_PROJECT=tsconfig.spec.json node --require ts-node/register --test \"spec/tests/**/*.spec.ts\"",
    "build": "tsc && chmod ugo+x lib/cli.js && cp src/retire.d.ts lib/retire.d.ts && cp ../LICENSE.md .",
    "watch": "tsc --watch ",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --fix",
    "format": "prettier --write \"src/**/*.ts\" \"spec/**/*.ts\"",
    "check": "npm run lint && npm run typecheck"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "keywords": [
    "sbom",
    "sbom-tool",
    "sbom-generator",
    "security",
    "cli",
    "software-composition-analysis",
    "sca"
  ],
  "type": "commonjs",
  "files": [
    "lib/**/*",
    "CHANGELOG.md",
    "LICENSE.md"
  ]
}
